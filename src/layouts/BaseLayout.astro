---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import { site, nav as navLinks } from "../data/site";
import CopyEmail from "../components/ui/CopyEmail.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;

const { email, linkedin, github, resume } = site;

const path = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

const linkClass =
  "text-muted transition-colors hover:text-text focus-visible:text-text aria-[current=page]:text-accent";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{pageTitle}</title>
    <!-- The headline's height changes when Inter swaps in, so have it ready for first paint. -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add("js");
      // ClientRouter replaces the <html> attributes on every navigation.
      document.addEventListener("astro:after-swap", () => document.documentElement.classList.add("js"));
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>

    <header class="border-b border-line bg-ink-950/80 backdrop-blur">
      <nav
        aria-label="Primary"
        class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-2 px-6 py-4 md:px-10"
      >
        <a
          href="/"
          class="font-semibold tracking-tight text-text"
          aria-current={path === "" ? "page" : undefined}
        >
          {site.name}
        </a>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={linkClass}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={resume}
              target="_blank"
              rel="noopener"
              class="text-muted transition-colors hover:text-text focus-visible:text-text"
            >
              Resume ↗
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1" data-scene="reveal">
      <slot />
    </main>

    <footer class="border-t border-line bg-ink-950">
      <div
        class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-12 md:px-10"
      >
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a
            href={`mailto:${email}`}
            class="font-mono text-text transition-colors hover:text-accent focus-visible:text-accent"
          >
            {email}
          </a>
          <CopyEmail email={email} />
          <a
            href={linkedin}
            class="text-muted transition-colors hover:text-text focus-visible:text-text"
          >
            LinkedIn ↗
          </a>
          <a
            href={github}
            class="text-muted transition-colors hover:text-text focus-visible:text-text"
          >
            GitHub ↗
          </a>
          <a
            href={resume}
            target="_blank"
            rel="noopener"
            class="text-muted transition-colors hover:text-text focus-visible:text-text"
          >
            Resume ↗
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import { gsap, MQ } from "../lib/gsap";
  import { onScene } from "../lib/scene";

  // Fade up section labels and titles once. Anything on screen at load stays as painted, so it never flashes.
  onScene("reveal", (root) => {
    const q = gsap.utils.selector(root);
    const mm = gsap.matchMedia();

    mm.add(MQ.motion, () => {
      const targets = q("[data-reveal]").filter((el) => el.getBoundingClientRect().top >= window.innerHeight);

      targets.forEach((el) => {
        // opacity, not autoAlpha: hidden text would drop out of screen readers and find-in-page.
        gsap.from(el, {
          opacity: 0,
          y: 16,
          scrollTrigger: { trigger: el, start: "clamp(top 85%)", once: true },
        });
      });
    });

    return () => mm.revert();
  });
</script>
