---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Pill from "../../components/ui/Pill.astro";
import MetricBadge from "../../components/ui/MetricBadge.astro";
import ArrowLink from "../../components/ui/ArrowLink.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import FlowDiagram from "../../components/diagrams/FlowDiagram.astro";
import LatencyBar from "../../components/scenes/LatencyBar.astro";
import PinnedSteps from "../../components/scenes/PinnedSteps.astro";
import PushPipelineScene from "../../components/scenes/PushPipelineScene.astro";
import AttendanceScene from "../../components/scenes/AttendanceScene.astro";
import ForYouScene from "../../components/scenes/ForYouScene.astro";
import CfErpScene from "../../components/scenes/CfErpScene.astro";
import { forYouAfter } from "../../components/diagrams/specs";
import { withBase } from "../../data/site";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { data } = entry;

const pushCaptions = {
  before:
    "Before: requests hit one API that loops over users. The request blocks and Firebase answers with 429 Too Many Requests.",
  after:
    "After: the API stores the job in a Redis queue and answers 202 Scheduled. Celery workers, backed by PostgreSQL, drain the queue and send to Firebase. Workers scale with load.",
};

const attendanceCaption =
  "A terminal pushes to the PUSH receiver. One transaction stores an immutable raw event and a work item. A single advisory-locked worker turns it into a daily result, which feeds 7 reports. Bounded retry, crash recovery and a heartbeat protect the worker. The calendar shows a placeholder month.";
const attendanceSteps = [
  "terminal → PUSH receiver → immutable raw event + work item (one transaction)",
  "Device re-sends the same upload → exact replays deduplicated; device gets OK only after the batch commits.",
  "single advisory-locked worker → daily result → 7 reports",
  "Terminal offline, uploads hours later → late punches recalculate the finalized day.",
];
const forYouCaption =
  "Search, view, cart, order and category signals, plus an admin boost, feed one hybrid score. The score orders the feed that one API serves to web and mobile.";

// Decisions read "Lead: rest". Show the lead in bold when there is one.
const splitDecision = (text: string) => {
  const i = text.indexOf(": ");
  return i === -1 ? { lead: null, rest: text } : { lead: text.slice(0, i), rest: text.slice(i + 2) };
};

const wide = "mx-auto w-full max-w-6xl px-6 md:px-10";
const prose = "max-w-[65ch]";
---

<BaseLayout title={data.title}>
  <article>
    <header class:list={[wide, "pt-16 md:pt-24"]}>
      <p class="font-mono text-xs uppercase tracking-[0.18em]">
        <a href={withBase("/work")} class="text-accent hover:text-text focus-visible:text-text">Work</a>
      </p>
      <h1 transition:name={`work-title-${entry.id}`} class="mt-6 text-4xl font-semibold tracking-[-0.02em] md:text-5xl">
        {data.title}
      </h1>
      <p class:list={["mt-4 text-lg text-muted", prose]}>{data.tagline}</p>

      <Card class="mt-10">
        <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-muted">Role</dt>
            <dd class="mt-2">{data.role}</dd>
          </div>
          {
            data.status && (
              <div>
                <dt class="font-mono text-xs uppercase tracking-wide text-muted">Status</dt>
                <dd class="mt-2">{data.status}</dd>
              </div>
            )
          }
          {
            data.device && (
              <div>
                <dt class="font-mono text-xs uppercase tracking-wide text-muted">Device</dt>
                <dd class="mt-2">{data.device}</dd>
              </div>
            )
          }
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-muted">Metric</dt>
            <dd class="mt-2"><MetricBadge>{data.metric}</MetricBadge></dd>
          </div>
          <div class="sm:col-span-2 lg:col-span-4">
            <dt class="font-mono text-xs uppercase tracking-wide text-muted">Stack</dt>
            <dd class="mt-2">
              <ul class="flex flex-wrap gap-2">
                {data.stack.map((s) => <li><Pill>{s}</Pill></li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </Card>
    </header>

    {
      data.context && (
        <section class:list={[wide, "pt-20"]}>
          <SectionLabel name="Context" />
          <p class:list={["mt-4 text-muted", prose]}>{data.context}</p>
        </section>
      )
    }

    {
      data.problem && (
        <section class:list={[wide, "pt-20"]}>
          <SectionLabel name="The problem" />
          <p class:list={["mt-4 text-muted", prose]}>{data.problem}</p>
          {entry.id === "push-pipeline" && <PushPipelineScene part="before" caption={pushCaptions.before} />}
        </section>
      )
    }

    {
      data.problems && (
        <section class:list={[wide, "pt-20"]}>
          <SectionLabel name="Problems and answers" />
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {data.problems.map((p) => (
              <li class="grid gap-1 py-4 md:grid-cols-[18rem_1fr] md:gap-8">
                <p class="font-semibold">{p.problem}</p>
                <p class="text-muted">{p.answer}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class:list={[wide, "pt-20"]}>
      <SectionLabel name="The design" />
      {
        entry.id === "push-pipeline" && (
          <div data-scene="push-after">
            <PinnedSteps steps={data.design.split(/(?<=\.) /)}>
              <PushPipelineScene part="after" caption={pushCaptions.after} />
            </PinnedSteps>
          </div>
        )
      }
      {
        entry.id === "attendance-backend" && (
          <>
            <p class:list={["mt-4 text-muted", prose]}>{data.design}</p>
            <div data-scene="attendance">
              <PinnedSteps steps={attendanceSteps}>
                <AttendanceScene caption={attendanceCaption} />
              </PinnedSteps>
            </div>
          </>
        )
      }
      {
        entry.id === "for-you" && (
          <>
            <p class:list={["mt-4 text-muted", prose]}>{data.design}</p>
            <FlowDiagram id="for-you-after" spec={forYouAfter} caption={forYouCaption} showCaption scroll class="mt-10" />
            <ForYouScene />
          </>
        )
      }
      {entry.id === "cf-erp" && <CfErpScene steps={data.design.split("; ")} />}
    </section>

    {
      data.alsoCovers && (
        <section class:list={[wide, "pt-20"]}>
          <SectionLabel name="Also on this page" />
          <p class:list={["mt-4 text-muted", prose]}>{data.alsoCovers}</p>
          <div class="mt-8 max-w-xl">
            <LatencyBar />
          </div>
        </section>
      )
    }

    <section class:list={[wide, "pt-20"]}>
      <SectionLabel name="Key decisions" />
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {
          data.decisions.map((d) => {
            const { lead, rest } = splitDecision(d);
            return (
              <li>
                <Card class="h-full">
                  <p class="text-muted">
                    {lead && <strong class="font-semibold text-text">{lead}: </strong>}
                    {rest}
                  </p>
                </Card>
              </li>
            );
          })
        }
      </ul>
    </section>

    {
      data.result && (
        <section class:list={[wide, "pt-20"]}>
          <SectionLabel name="Result" />
          <p class:list={["mt-4 text-muted", prose]}>{data.result}</p>
        </section>
      )
    }

    <section class:list={[wide, "py-24"]}>
      <SectionLabel name="Next case study" />
      <p class="mt-4 text-2xl font-semibold tracking-[-0.02em]">
        <ArrowLink href={withBase(`/work/${next.id}`)}>{next.data.title}</ArrowLink>
      </p>
    </section>
  </article>
</BaseLayout>
