---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return ["push-pipeline", "attendance-backend", "for-you", "cf-erp"].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
---

<BaseLayout title="Work">
  <section class="mx-auto w-full max-w-6xl px-6 py-24 md:px-10 md:py-32">
    <h1 class="text-4xl font-semibold tracking-tight">{slug}</h1>
  </section>
</BaseLayout>
