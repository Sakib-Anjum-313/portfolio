---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceList from "../components/sections/ExperienceList.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
import ArrowLink from "../components/ui/ArrowLink.astro";
import Button from "../components/ui/Button.astro";
import photo from "../assets/sakib-avatar.png";
import { site, about, skills, education } from "../data/site";

const navItems = [
  { label: "Experience", href: "#experience" },
  { label: "Skills", href: "#skills" },
  { label: "Education", href: "#education" },
];
---

<BaseLayout title="Experience">
  <div data-scene="experience" class="relative isolate">
  <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
    <div class="lg:flex lg:justify-between lg:gap-16">
      <header
        class="py-16 lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[40%] lg:flex-col lg:justify-between lg:overflow-y-auto lg:py-20"
      >
        <div>
          <h1 class="text-4xl font-semibold tracking-[-0.02em] md:text-5xl">{site.name}</h1>
          <p class="mt-3 text-lg text-text">{site.role}</p>
          <p class="mt-4 max-w-xs text-muted">{site.positioning}</p>

          <Image
            data-part="portrait"
            src={photo}
            alt="Portrait of Sakib Anjum, wearing glasses and a black shirt, inside a glowing ring with a code symbol beside him"
            width={480}
            height={480}
            loading="eager"
            class="mt-8 size-60 lg:[@media(max-height:800px)]:size-48"
          />

          <nav aria-label="On this page" class="mt-10">
            <ul class="relative space-y-3 font-mono text-xs uppercase tracking-[0.18em]">
              <li
                data-part="indicator"
                aria-hidden="true"
                class="pointer-events-none absolute left-0 top-0 hidden h-px w-8 bg-accent opacity-0 lg:block"
              >
              </li>
              {
                navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      data-part="nav-link"
                      class="group inline-flex items-center gap-3 text-muted hover:text-text focus-visible:text-text aria-[current=true]:text-text"
                    >
                      <span
                        aria-hidden="true"
                        class="h-px w-8 bg-line transition-all group-hover:w-16 group-hover:bg-accent group-focus-visible:w-16 group-focus-visible:bg-accent motion-reduce:transition-none"
                      />
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 lg:mt-12">
          <a
            href={site.github}
            class="text-sm text-muted transition-colors hover:text-text focus-visible:text-text"
          >
            GitHub ↗
          </a>
          <a
            href={site.linkedin}
            class="text-sm text-muted transition-colors hover:text-text focus-visible:text-text"
          >
            LinkedIn ↗
          </a>
          <Button href={site.resume} newTab>Resume</Button>
        </div>
      </header>

      <div class="space-y-24 pb-24 lg:w-[55%] lg:py-20">
        <section>
          <SectionLabel name="About" class="mb-6" />
          <p class="max-w-[65ch] text-muted">{about}</p>
        </section>

        <section id="experience" class="relative scroll-mt-8">
          <span data-part="rail" aria-hidden="true" class="absolute -left-8 inset-y-0 hidden w-px bg-line lg:block">
            <span data-part="rail-fill" class="block size-full origin-top bg-accent"></span>
          </span>
          <SectionLabel name="Experience" class="mb-6" />
          <ExperienceList prehide />
        </section>

        <section id="skills" class="scroll-mt-8">
          <SectionLabel name="Skills" class="mb-6" />
          <dl class="space-y-6">
            {
              skills.map((s) => (
                <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-6">
                  <dt class="font-mono text-xs uppercase tracking-wide text-muted">{s.group}</dt>
                  <dd class="text-text">{s.items.join(", ")}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section id="education" class="scroll-mt-8">
          <SectionLabel name="Education & learning" class="mb-6" />
          <p class="max-w-[65ch] text-text">{education.degree}</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-muted marker:text-accent">
            {education.learning.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <p>
          <ArrowLink href={site.resume} external newTab>View full résumé</ArrowLink>
        </p>
      </div>
    </div>
  </div>
  </div>
</BaseLayout>

<script>
  import { gsap, MQ, ScrollTrigger } from "../lib/gsap";
  import { onScene } from "../lib/scene";
  import { blueprintCursor } from "../lib/cursor";

  onScene("experience", (root) => {
    const q = gsap.utils.selector(root);
    const stopCursor = blueprintCursor(root);
    const mm = gsap.matchMedia();

    mm.add({ motion: MQ.motion, desktop: MQ.desktop }, (ctx) => {
      const { motion, desktop } = ctx.conditions as Record<string, boolean>;
      if (!desktop) return;

      const links = q("[data-part=nav-link]");
      const indicator = q("[data-part=indicator]")[0];
      const duration = motion ? 0.35 : 0;

      const setActive = (index: number) => {
        links.forEach((link, i) => {
          if (i === index) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
        if (index < 0) {
          gsap.to(indicator, { opacity: 0, duration, overwrite: "auto" });
          return;
        }
        const row = links[index];
        gsap.to(indicator, {
          opacity: 1,
          y: row.offsetTop + row.offsetHeight / 2,
          duration,
          overwrite: "auto",
        });
      };

      const sections = links.map((link) => q(link.getAttribute("href")!)[0]);
      // Mid-viewport, or the page end for sections that can never scroll that far.
      const reach = (section: HTMLElement) =>
        Math.min(
          section.getBoundingClientRect().top + window.scrollY - window.innerHeight / 2,
          ScrollTrigger.maxScroll(window) - 1
        );

      // A click says which section is wanted, so the triggers the jump crosses can't overrule it.
      let holdUntil = 0;
      const follow = (index: number) => {
        if (performance.now() >= holdUntil) setActive(index);
      };
      const clicks = links.map((_, i) => () => {
        holdUntil = performance.now() + 300;
        setActive(i);
      });
      links.forEach((link, i) => link.addEventListener("click", clicks[i]));

      sections.forEach((section, i) => {
        const next = sections[i + 1];
        // The ranges touch, so an anchor jump always lands inside exactly one of them.
        ScrollTrigger.create({
          trigger: section,
          start: () => reach(section),
          // A trigger stops being active at its exact end, so the last one ends just past the page.
          end: () => (next ? reach(next) : ScrollTrigger.maxScroll(window) + 1),
          onToggle: (self) => {
            if (self.isActive) follow(i);
          },
          onLeaveBack: () => {
            if (i === 0) follow(-1);
          },
        });
      });

      if (motion) {
        gsap.from(q("[data-part=rail-fill]"), {
          scaleY: 0,
          ease: "none",
          scrollTrigger: {
            trigger: q("[data-part=rail]")[0],
            start: "top 60%",
            end: "bottom 60%",
            scrub: 0.4,
          },
        });
      }

      return () => {
        links.forEach((link, i) => link.removeEventListener("click", clicks[i]));
        setActive(-1);
      };
    });

    return () => {
      mm.revert();
      stopCursor();
    };
  });
</script>
