---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
import Card from "../components/ui/Card.astro";
import Pill from "../components/ui/Pill.astro";
import ArrowLink from "../components/ui/ArrowLink.astro";
import Button from "../components/ui/Button.astro";
import FlowDiagram from "../components/diagrams/FlowDiagram.astro";
import { aiLanes } from "../components/diagrams/specs";
import { site } from "../data/site";
import {
  aiWorkflow,
  principles,
  walkthrough,
  theCatch,
  checklist,
  toolkit,
  proofBuiltIn,
} from "../data/ai-workflow";

const wide = "mx-auto w-full max-w-6xl px-6 md:px-10 py-20 md:py-24";
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title="AI Workflow">
  <header class="mx-auto w-full max-w-6xl px-6 pb-8 pt-20 md:px-10 md:pt-28">
    <h1 class="max-w-[18ch] text-[clamp(2.5rem,6vw,4.75rem)] font-semibold leading-[1.05] tracking-[-0.03em]">
      {aiWorkflow.headline}
    </h1>
    <p class="mt-6 max-w-[65ch] text-lg text-muted">{aiWorkflow.subline}</p>
    <p
      class="mt-8 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 font-mono text-xs text-text"
    >
      <span class="size-1.5 rounded-full bg-wait" aria-hidden="true"></span>
      {aiWorkflow.certification}
    </p>
  </header>

  <section class={wide}>
    <SectionLabel name="Principles" />
    <ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        principles.map((p, i) => (
          <li>
            <Card class="h-full">
              <p class="font-mono text-xs tabular-nums text-accent">{pad(i + 1)}</p>
              <h3 class="mt-3 text-lg font-semibold tracking-[-0.02em]">{p.title}</h3>
              <p class="mt-2 text-muted">{p.body}</p>
            </Card>
          </li>
        ))
      }
    </ol>
  </section>

  <section class={wide}>
    <SectionLabel name="How I ship a feature with AI" />
    <p class="mt-4 max-w-[65ch] text-muted">Example: the SenseFace 2A attendance integration.</p>
    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,22rem)_1fr]">
      <div class="hidden lg:block">
        <div class="sticky top-8">
          <FlowDiagram
            id="ai-lanes"
            spec={aiLanes}
            caption="Two lanes, AI and me. In each of the first six steps the AI hands its work to me to check. The seventh step, merge, is mine alone."
          />
        </div>
      </div>
      <ol class="space-y-4">
        {
          walkthrough.map((s) => (
            <li>
              <Card>
                <h3 class="text-lg font-semibold tracking-[-0.02em]">{s.step}</h3>
                <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                  <div>
                    <dt class="font-mono text-xs uppercase tracking-wide text-accent">What the AI does</dt>
                    <dd class="mt-1 text-muted">{s.ai}</dd>
                  </div>
                  <div>
                    <dt class="font-mono text-xs uppercase tracking-wide text-accent">What I do</dt>
                    <dd class="mt-1 text-muted">{s.me}</dd>
                  </div>
                </dl>
              </Card>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class={wide}>
    <SectionLabel name="The catch" />
    <div class="mt-10 max-w-3xl overflow-hidden rounded-lg border border-line bg-ink-900">
      <p class="border-b border-line px-5 py-3 font-mono text-xs text-muted">
        Reconstruction of the exchange, not a verbatim log.
      </p>
      <div class="space-y-5 p-5 font-mono text-sm leading-relaxed">
        <p>
          <span class="text-accent">AI</span>
          <span class="text-muted line-through decoration-fail decoration-2">{theCatch.claim}</span>
        </p>
        <p>
          <span class="text-accent">Me</span>
          <span class="text-text">{theCatch.challenge}</span>
        </p>
        <p class="border-l-2 border-ok pl-4">
          <span class="text-accent">AI</span>
          <span class="text-text">{theCatch.result}</span>
        </p>
        <p class="font-sans text-base font-semibold text-text">{theCatch.lesson}</p>
      </div>
    </div>
  </section>

  <section class={wide}>
    <SectionLabel name="Verification checklist" />
    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_auto] lg:items-start">
      <ol class="max-w-3xl space-y-4">
        {
          checklist.map((item) => (
            <li class="flex gap-4">
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                class="mt-1 size-5 shrink-0"
                fill="none"
                stroke-width="1.5"
              >
                <rect x="1" y="1" width="18" height="18" rx="4" class="stroke-ok" />
                <path d="M5.5 10.5 L8.5 13.5 L14.5 7" class="stroke-ok" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="text-muted">{item}</span>
            </li>
          ))
        }
      </ol>
      <p class="font-mono text-2xl font-semibold tabular-nums text-text">
        {checklist.length}/{checklist.length} <span class="text-sm font-normal text-muted">before merge</span>
      </p>
    </div>
  </section>

  <section class={wide}>
    <SectionLabel name="Toolkit" />
    <dl class="mt-10 space-y-6">
      {
        toolkit.map((g) => (
          <div class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <dt class="pt-1 font-mono text-xs uppercase tracking-wide text-muted">{g.group}</dt>
            <dd>
              <ul class="flex flex-wrap gap-2">
                {g.items.map((item) => (
                  <li>
                    <Pill>{item}</Pill>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class={wide}>
    <SectionLabel name="Proof" />
    <Card class="mt-10 max-w-3xl">
      <h3 class="text-lg font-semibold tracking-[-0.02em]">This site was built the same way</h3>
      <p class="mt-3 text-muted">{proofBuiltIn.body}</p>
      {
        proofBuiltIn.repoUrl && (
          <p class="mt-4">
            <ArrowLink href={proofBuiltIn.repoUrl} external>{proofBuiltIn.linkLabel}</ArrowLink>
          </p>
        )
      }
    </Card>
    <p class="mt-8 max-w-[65ch] text-muted">{aiWorkflow.teamAngle}</p>
  </section>

  <section class:list={[wide, "pb-32"]}>
    <div class="flex flex-wrap items-center gap-6">
      <Button href="/work/attendance-backend">Read the attendance case study</Button>
      <Button href={site.resume} variant="ghost" newTab>Download resume</Button>
    </div>
  </section>
</BaseLayout>
