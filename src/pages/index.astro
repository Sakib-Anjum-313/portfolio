---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ProofStrip from "../components/sections/ProofStrip.astro";
import FeaturedSystems from "../components/sections/FeaturedSystems.astro";
import HowIWork from "../components/sections/HowIWork.astro";
import ExperienceList from "../components/sections/ExperienceList.astro";
import AiWorkflowTeaser from "../components/sections/AiWorkflowTeaser.astro";
import ContactCta from "../components/sections/ContactCta.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
import ArrowLink from "../components/ui/ArrowLink.astro";
---

<BaseLayout>
  <Hero />
  <ProofStrip />
  <FeaturedSystems />
  <HowIWork />
  <section class="mx-auto w-full max-w-6xl px-6 py-24 md:px-10 md:py-32">
    <SectionLabel index="03" name="EXPERIENCE" />
    <div class="mt-10">
      <ExperienceList compact />
    </div>
    <p class="mt-8">
      <ArrowLink href="/experience">Full experience</ArrowLink>
    </p>
  </section>
  <AiWorkflowTeaser />
  <ContactCta />
</BaseLayout>
