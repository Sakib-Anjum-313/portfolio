---
import FlowDiagram from "../diagrams/FlowDiagram.astro";
import { cfErpAfter } from "../diagrams/specs";
import PinnedSteps from "./PinnedSteps.astro";

interface Props {
  steps: readonly string[];
}

const { steps } = Astro.props;
---

<div data-scene="cf-erp">
  <PinnedSteps steps={steps}>
    <FlowDiagram
      id="cf-erp-after"
      spec={cfErpAfter}
      showCaption
      scroll
      caption="Jobs, vouchers, billing, accounts and HR are separate modules. A voucher posts an entry, and Ledger, Journal and Contra all derive from that same posted entry, so they agree."
    >
      <g data-part="voucher" class="opacity-0">
        <rect x="-32" y="-10" width="64" height="20" rx="10" stroke-width="1.25" class="fill-ink-950 stroke-accent"></rect>
        <text y="4" text-anchor="middle" font-size="12" class="fill-accent font-mono">voucher</text>
      </g>
    </FlowDiagram>
  </PinnedSteps>
</div>

<script>
  import { gsap, MQ } from "../../lib/gsap";
  import { onScene } from "../../lib/scene";
  import { playSteps } from "../../lib/steps";

  const node = (id: string) => `[data-node="${id}"]`;
  const VOUCHER = { x: 170, y: 20 };
  const POSTED_Y = 118;

  onScene("cf-erp", (root) => {
    const q = gsap.utils.selector(root);
    const mm = gsap.matchMedia();

    mm.add({ motion: MQ.motion, desktop: MQ.desktop }, (ctx) => {
      const { motion, desktop } = ctx.conditions as Record<string, boolean>;
      if (!motion) return;

      const [agree1, agree2, count] = q("[data-part=note]");
      const voucher = q("[data-part=voucher]");
      const reports = q([node("ledger"), node("journal"), node("contra")].join(","));
      const toReports = q('[data-from="posted"]');

      gsap.set(voucher, VOUCHER);

      const tl = gsap.timeline({ paused: true, defaults: { duration: 0.3 } });
      tl.addLabel("step0", 0);
      tl.from(q([node("jobs"), node("vouchers"), node("billing"), node("accounts")].join(",")), { opacity: 0.3, stagger: 0.1 }, 0);
      tl.addLabel("step1", 0.8);

      tl.to(voucher, { opacity: 1, duration: 0.15 }, 0.85);
      tl.from(q('[data-from="vouchers"]'), { drawSVG: "0%", opacity: 0, duration: 0.4 }, 0.95);
      tl.to(voucher, { y: POSTED_Y, duration: 0.5, ease: "power1.inOut" }, 0.95);
      tl.from(q(node("posted")), { opacity: 0.3 }, 1.3);
      tl.to(voucher, { opacity: 0, duration: 0.15 }, 1.45);
      // The same moment on purpose: one posted entry, every report at once.
      tl.from(toReports, { drawSVG: "0%", opacity: 0, duration: 0.4 }, 1.6);
      tl.from(reports, { opacity: 0.25, duration: 0.3 }, 1.9);
      tl.from([agree1, agree2], { opacity: 0 }, 2);
      tl.addLabel("step2", 2.4);

      tl.from(q(node("hr")), { opacity: 0.3 }, 2.45);
      tl.from(count, { opacity: 0 }, 2.45);
      tl.addLabel("step3", 2.8);

      return playSteps(root, tl, desktop);
    });

    return () => mm.revert();
  });
</script>
