---
import { DEFAULT_TRAFFIC, MAX_JOBS, MAX_WORKERS, jobsFor, readout, workersFor } from "./push-model";

interface Props {
  part: "before" | "after";
  caption: string;
}

const { part, caption } = Astro.props;

const box = "fill-ink-900 stroke-line";
const label = "fill-text font-mono";
const note = "fill-muted font-mono";

// Worker rows, filled from the middle outward so the fan stays centred on the queue's line.
const ROWS = [124, 156, 92, 188, 60, 220];
const LINE_Y = 140;
const jobs = jobsFor(DEFAULT_TRAFFIC);
const workers = workersFor(DEFAULT_TRAFFIC);
const pile = Array.from({ length: 9 }, (_, i) => ({ x: 110 + (i % 3) * 24, y: 44 + Math.floor(i / 3) * 12 }));
---

{
  part === "before" ? (
    <figure data-scene="push-before" class="m-0 mt-10" style="max-width:784px">
      <div class="overflow-x-auto">
        <svg viewBox="0 0 560 150" class="block h-auto w-full" style="min-width:560px" aria-hidden="true">
          <defs>
            <marker id="pp-before-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
              <path d="M0 0 L8 4 L0 8 z" class="fill-accent" />
            </marker>
          </defs>
          <path d="M100 62 H190" fill="none" stroke-width="1.25" class="stroke-accent" marker-end="url(#pp-before-arrow)" />
          <path d="M330 62 H440" fill="none" stroke-width="1.25" stroke-dasharray="4 4" class="stroke-fail" />

          <g>
            <rect x="0" y="40" width="100" height="44" rx="8" stroke-width="1.25" class={box} />
            <text x="50" y="66" text-anchor="middle" font-size="12" class={label}>Requests</text>
          </g>

          {pile.map((p) => <rect data-part="req" x={p.x} y={p.y} width="18" height="8" rx="2" class="fill-accent" />)}

          <g data-part="api">
            <rect x="190" y="40" width="140" height="44" rx="8" stroke-width="1.25" class={box} />
            <rect data-part="load-wait" x="191" y="41" width="138" height="42" rx="7" class="fill-wait opacity-0" />
            <rect data-part="load-fail" x="191" y="41" width="138" height="42" rx="7" class="fill-fail opacity-20" />
            <rect data-part="outline-wait" x="190" y="40" width="140" height="44" rx="8" fill="none" stroke-width="1.25" class="stroke-wait opacity-0" />
            <rect data-part="outline-fail" x="190" y="40" width="140" height="44" rx="8" fill="none" stroke-width="1.25" class="stroke-fail" />
            <text x="260" y="60" text-anchor="middle" font-size="12" class={label}>API</text>
            <text x="260" y="75" text-anchor="middle" font-size="12" class={note}>loops over users</text>
          </g>

          <g>
            <rect x="440" y="40" width="120" height="44" rx="8" stroke-width="1.25" class={box} />
            <text x="500" y="66" text-anchor="middle" font-size="12" class={label}>Firebase</text>
          </g>

          <text data-part="blocks" x="260" y="112" text-anchor="middle" font-size="12" class="fill-fail font-mono">Blocks, can crash</text>
          <text data-part="too-many" x="484" y="112" text-anchor="middle" font-size="12" class="fill-fail font-mono">429 Too Many Requests</text>
        </svg>
      </div>
      <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
    </figure>
  ) : (
    <figure data-part="stage" class="m-0">
      <div class="overflow-x-auto">
        <svg viewBox="0 0 640 290" class="block h-auto w-full" style="min-width:640px" aria-hidden="true">
          <defs>
            <marker id="pp-after-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
              <path d="M0 0 L8 4 L0 8 z" class="fill-accent" />
            </marker>
          </defs>

          <path d={`M76 ${LINE_Y} H120`} fill="none" stroke-width="1.25" class="stroke-accent" marker-end="url(#pp-after-arrow)" />
          <path d={`M192 ${LINE_Y} H236`} fill="none" stroke-width="1.25" class="stroke-accent" marker-end="url(#pp-after-arrow)" />

          <g>
            <rect x="0" y="118" width="76" height="44" rx="8" stroke-width="1.25" class={box} />
            <text x="38" y="144" text-anchor="middle" font-size="12" class={label}>Requests</text>
          </g>
          <g>
            <rect x="120" y="118" width="72" height="44" rx="8" stroke-width="1.25" class={box} />
            <text x="156" y="144" text-anchor="middle" font-size="12" class={label}>API</text>
          </g>
          <text data-part="ack" x="156" y="192" text-anchor="middle" font-size="12" class="fill-ok font-mono">202 Scheduled</text>

          <g>
            <rect x="236" y="50" width="96" height="180" rx="8" stroke-width="1.25" class="fill-ink-900 stroke-accent" />
            <text x="284" y="72" text-anchor="middle" font-size="12" class={label}>Queue</text>
            <text x="284" y="88" text-anchor="middle" font-size="12" class={note}>Redis</text>
          </g>
          <g data-part="jobs">
            {
              Array.from({ length: MAX_JOBS }, (_, i) => (
                <rect
                  data-part="job"
                  x="248"
                  y={214 - i * 10}
                  width="72"
                  height="7"
                  rx="2"
                  class="fill-wait"
                  style={i < jobs ? undefined : "opacity:0"}
                />
              ))
            }
          </g>
          <text data-part="absorb" x="284" y="252" text-anchor="middle" font-size="12" class={note}>Absorbs spikes</text>

          <g data-part="workers">
            <text x="430" y="24" text-anchor="middle" font-size="12" class={label}>Workers</text>
            <text x="430" y="40" text-anchor="middle" font-size="12" class={note}>Celery</text>
            {
              Array.from({ length: MAX_WORKERS }, (_, i) => {
                const y = ROWS[i];
                return (
                  <g data-part="worker" style={i < workers ? undefined : "opacity:0"}>
                    <path data-part="pull" d={`M332 ${LINE_Y} C354 ${LINE_Y} 354 ${y} 376 ${y}`} fill="none" stroke-width="1.25" class="stroke-accent" />
                    <path data-part="send" d={`M484 ${y} C512 ${y} 512 ${LINE_Y} 540 ${LINE_Y}`} fill="none" stroke-width="1.25" class="stroke-accent" />
                    <rect x="376" y={y - 12} width="108" height="24" rx="8" stroke-width="1.25" class="fill-ink-900 stroke-accent" />
                    <text x="430" y={y + 4} text-anchor="middle" font-size="12" class={label}>Worker</text>
                  </g>
                );
              })
            }
          </g>
          <text data-part="scale" x="430" y="256" text-anchor="middle" font-size="12" class={note}>Scale with load</text>
          <text data-part="scale" x="430" y="274" text-anchor="middle" font-size="12" class={note}>Backed by PostgreSQL</text>

          <g>
            <rect x="540" y="118" width="100" height="44" rx="8" stroke-width="1.25" class={box} />
            <text x="590" y="144" text-anchor="middle" font-size="12" class={label}>Firebase</text>
          </g>

          <rect data-part="drop" x="62" y={LINE_Y - 4} width="28" height="8" rx="2" class="fill-accent opacity-0" />
          <circle data-part="in" cx="76" cy={LINE_Y} r="2.5" class="fill-accent opacity-0" />
          <circle data-part="out" r="2.5" class="fill-accent opacity-0" />
          <circle data-part="out" r="2.5" class="fill-accent opacity-0" />
        </svg>
      </div>
      <div data-part="controls" hidden class="mt-6">
        <label for="pp-traffic" class="font-mono text-xs uppercase tracking-wide text-muted">Traffic</label>
        <input
          id="pp-traffic"
          data-part="traffic"
          type="range"
          min="0"
          max="100"
          step="5"
          value={DEFAULT_TRAFFIC}
          class="mt-2 block w-full max-w-md accent-accent"
        />
        <output for="pp-traffic" data-part="readout" class="mt-2 block font-mono text-xs tabular-nums text-text">
          {readout(DEFAULT_TRAFFIC)}
        </output>
      </div>
      <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
    </figure>
  )
}

<script>
  import { gsap, MQ, ScrollTrigger } from "../../lib/gsap";
  import { onScene } from "../../lib/scene";
  import { playSteps } from "../../lib/steps";
  import { DEFAULT_TRAFFIC, jobsFor, readout, workersFor } from "./push-model";

  onScene("push-before", (root) => {
    const q = gsap.utils.selector(root);
    const mm = gsap.matchMedia();

    mm.add(MQ.motion, () => {
      // Narrow screens scroll this diagram sideways, so bring Firebase's 429 into view.
      const scroller = q(".overflow-x-auto")[0];
      gsap
        .timeline({ scrollTrigger: { trigger: root, start: "top 75%", once: true } })
        .call(() => scroller.scrollTo({ left: scroller.scrollWidth, behavior: "smooth" }), undefined, 1.5)
        .from(q("[data-part=req]"), { x: -110, opacity: 0, stagger: 0.08, duration: 0.4 }, 0)
        .fromTo(
          q("[data-part=load-wait]"),
          { opacity: 0, scaleY: 0, transformOrigin: "50% 100%" },
          { opacity: 0.25, scaleY: 1, duration: 1, ease: "power1.in" },
          0.2
        )
        .from(q("[data-part=outline-fail]"), { opacity: 0, duration: 0.2 }, 1.7)
        .fromTo(q("[data-part=outline-wait]"), { opacity: 0 }, { opacity: 1, duration: 0.2 }, 0.8)
        .to(q("[data-part=api]"), { x: 3, duration: 0.05, repeat: 7, yoyo: true, ease: "none" }, 1.2)
        .from(q("[data-part=load-fail]"), { opacity: 0, duration: 0.2 }, 1.7)
        .to(q("[data-part=load-wait]"), { opacity: 0, duration: 0.2 }, 1.7)
        .to(q("[data-part=outline-wait]"), { opacity: 0, duration: 0.2 }, 1.7)
        .from(q("[data-part=blocks]"), { opacity: 0, y: 6, duration: 0.3 }, 1.8)
        .from(q("[data-part=too-many]"), { opacity: 0, y: 6, duration: 0.3 }, 2);
    });

    return () => mm.revert();
  });

  onScene("push-after", (root) => {
    const q = gsap.utils.selector(root);
    const controls = q("[data-part=controls]")[0] as HTMLElement;
    const slider = q("[data-part=traffic]")[0] as HTMLInputElement;
    const output = q("[data-part=readout]")[0] as HTMLOutputElement;
    const jobs = q("[data-part=job]");
    const workers = q("[data-part=worker]");
    controls.hidden = false;

    const mm = gsap.matchMedia();

    mm.add({ motion: MQ.motion, reduce: MQ.reduce, desktop: MQ.desktop }, (ctx) => {
      const { motion, desktop } = ctx.conditions as Record<string, boolean>;
      const duration = motion ? 0.35 : 0;
      let loop: gsap.core.Timeline | undefined;

      const render = (traffic: number) => {
        const jobCount = jobsFor(traffic);
        const workerCount = workersFor(traffic);
        slider.value = String(traffic);
        output.textContent = readout(traffic);
        slider.setAttribute("aria-valuetext", readout(traffic));
        jobs.forEach((job, i) => gsap.to(job, { opacity: i < jobCount ? 1 : 0, duration, overwrite: "auto" }));
        workers.forEach((worker, i) => gsap.to(worker, { opacity: i < workerCount ? 1 : 0, duration, overwrite: "auto" }));
        loop?.timeScale(gsap.utils.mapRange(0, 100, 0.6, 2, traffic));
      };

      let touched = false;
      const onInput = () => {
        touched = true;
        render(Number(slider.value));
      };
      slider.addEventListener("input", onInput);
      render(DEFAULT_TRAFFIC);

      let stopSteps = () => {};
      if (motion) {
        // Data keeps flowing while the scene is on screen. Two workers always run, so those carry the dots.
        const routes = gsap.utils.toArray<SVGPathElement>("[data-part=send]", root).slice(0, 2);
        loop = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 0.3, defaults: { ease: "none" } });
        loop
          .fromTo(q("[data-part=in]"), { x: 0, opacity: 1 }, { x: 160, duration: 0.9 }, 0)
          .set(q("[data-part=in]"), { opacity: 0 });
        gsap.utils.toArray<SVGCircleElement>("[data-part=out]", root).forEach((dot, i) => {
          const at = 0.3 + i * 0.4;
          loop!
            .set(dot, { opacity: 1 }, at)
            .to(dot, { motionPath: { path: routes[i], align: routes[i], alignOrigin: [0.5, 0.5] }, duration: 0.6 }, at)
            .set(dot, { opacity: 0 });
        });

        const demand = { traffic: DEFAULT_TRAFFIC };
        const tl = gsap.timeline({
          paused: true,
          onComplete: () => void loop?.play(),
        });
        tl.addLabel("step0", 0);
        tl.to(q("[data-part=drop]"), { opacity: 1, duration: 0.15 }, 0)
          .to(q("[data-part=drop]"), { x: 185, duration: 0.5, ease: "power1.in" }, 0.05)
          .to(q("[data-part=drop]"), { y: 60, opacity: 0, duration: 0.25, ease: "power1.in" }, 0.55)
          .from(q("[data-part=ack]"), { opacity: 0, y: 6, duration: 0.3 }, 0.45)
          .from(q("[data-part=jobs]"), { opacity: 0, y: -10, duration: 0.3 }, 0.7)
          .from(q("[data-part=absorb]"), { opacity: 0, duration: 0.3 }, 0.8)
          .addLabel("step1", 1.1)
          // Narrow screens scroll this diagram sideways: keep the queue and the workers side by side for the slider.
          .call(() => q(".overflow-x-auto")[0].scrollTo({ left: 230, behavior: "smooth" }), undefined, 1.1)
          .from(q("[data-part=workers]"), { opacity: 0, x: -14, duration: 0.5 }, 1.2)
          .addLabel("step2", 1.8)
          .from(q("[data-part=scale]"), { opacity: 0, duration: 0.3 }, 1.9)
          .to(
            demand,
            {
              traffic: 100,
              duration: 0.9,
              ease: "none",
              onUpdate: () => {
                if (!touched) render(Math.round(demand.traffic / 5) * 5);
              },
            },
            1.9
          )
          .addLabel("step3", 2.8);
        stopSteps = playSteps(root, tl, desktop);

        ScrollTrigger.create({
          trigger: root,
          onToggle: (self) => {
            if (tl.progress() === 1) loop?.paused(!self.isActive);
          },
        });
      }

      return () => {
        slider.removeEventListener("input", onInput);
        slider.value = String(DEFAULT_TRAFFIC);
        slider.removeAttribute("aria-valuetext");
        output.textContent = readout(DEFAULT_TRAFFIC);
        stopSteps();
      };
    });

    return () => {
      mm.revert();
      controls.hidden = true;
    };
  });
</script>
