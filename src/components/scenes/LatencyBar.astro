---
interface Props {
  /** One bar and one label, for the home proof strip. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const layers = ["slow query", "missing index", "no cache"];
---

{
  compact ? (
    <div data-scene="latency-mini" class="mt-3" aria-hidden="true">
      <div class="h-1.5 w-full rounded-full bg-line">
        <div data-part="bar" class="h-full w-1/3 origin-left rounded-full bg-accent" />
      </div>
      <p data-part="label" class="mt-1.5 font-mono text-xs tabular-nums text-text">0.4s</p>
    </div>
  ) : (
    <figure data-scene="latency" class="m-0 font-mono text-sm tabular-nums">
      <div class="mb-1.5 flex justify-between text-muted">
        <span>Order API</span>
        <span data-part="total" class="text-text">0.4s · −67%</span>
      </div>
      <div class="flex h-2 w-full gap-px" aria-hidden="true">
        <div class="h-full w-1/3 rounded-l-full bg-accent" />
        {layers.map(() => <div data-part="layer" class="h-full flex-1 bg-fail opacity-20" />)}
      </div>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-muted">
        {layers.map((layer) => <li data-part="fix" class="line-through">{layer}</li>)}
      </ul>
      <figcaption class="sr-only">
        The Order API started at 1.2s. Fixing a slow query, a missing index and the lack of a cache brought it to 0.4s.
      </figcaption>
    </figure>
  )
}

<script>
  import { gsap, MQ } from "../../lib/gsap";
  import { onScene } from "../../lib/scene";

  onScene("latency-mini", (root) => {
    const q = gsap.utils.selector(root);
    const label = q("[data-part=label]")[0] as HTMLElement;
    const final = label.textContent;
    const mm = gsap.matchMedia();

    mm.add(MQ.motion, () => {
      const time = { value: 1.2 };
      label.textContent = "1.2s";
      gsap
        .timeline({
          defaults: { duration: 1.2, ease: "power2.inOut" },
          scrollTrigger: { trigger: root, start: "top 90%", once: true },
        })
        .from(q("[data-part=bar]"), { scaleX: 3 }, 0.2)
        .to(
          time,
          {
            value: 0.4,
            onUpdate: () => {
              label.textContent = `${time.value.toFixed(1)}s`;
            },
          },
          0.2
        );
      return () => {
        label.textContent = final;
      };
    });

    return () => mm.revert();
  });

  onScene("latency", (root) => {
    const q = gsap.utils.selector(root);
    const total = q("[data-part=total]")[0] as HTMLElement;
    const final = total.textContent;
    const mm = gsap.matchMedia();

    mm.add(MQ.motion, () => {
      const layers = q("[data-part=layer]");
      const fixes = q("[data-part=fix]");
      total.textContent = "1.2s";
      fixes.forEach((fix) => fix.classList.remove("line-through"));

      const tl = gsap.timeline({ scrollTrigger: { trigger: root, start: "top 85%", once: true } });
      gsap.set(layers, { opacity: 1 });
      layers.forEach((layer, i) => {
        const at = 0.4 + i * 0.6;
        tl.to(layer, { opacity: 0.2, duration: 0.45 }, at);
        tl.call(() => fixes[i].classList.add("line-through"), undefined, at + 0.2);
      });
      tl.call(() => (total.textContent = final));

      return () => {
        total.textContent = final;
        fixes.forEach((fix) => fix.classList.add("line-through"));
      };
    });

    return () => mm.revert();
  });
</script>
