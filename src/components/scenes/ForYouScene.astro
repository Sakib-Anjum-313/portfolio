---
import { SIGNALS, rank, scoreOf } from "./for-you-model";

const toggles = [...SIGNALS.map((s) => ({ key: s, on: true })), { key: "Admin boost", on: false }];
const shapes = {
  circle: '<circle cx="16" cy="16" r="12" />',
  square: '<rect x="5" y="5" width="22" height="22" rx="3" />',
  triangle: '<path d="M16 5 L28 27 H4 Z" />',
  diamond: '<path d="M16 3 L29 16 L16 29 L3 16 Z" />',
  pill: '<rect x="3" y="10" width="26" height="12" rx="6" />',
  hexagon: '<path d="M9 4 H23 L30 16 L23 28 H9 L2 16 Z" />',
};
const products = rank(SIGNALS, false);
---

<figure data-scene="for-you" class="m-0 mt-10">
  <div data-part="toggles" hidden role="group" aria-label="Ranking signals" class="flex flex-wrap gap-2">
    {
      toggles.map((t) => (
        <button
          type="button"
          data-signal={t.key}
          aria-pressed={t.on ? "true" : "false"}
          class="rounded-full border border-line px-4 py-1.5 text-sm text-muted transition-colors hover:border-accent/40 hover:text-text focus-visible:border-accent/40 focus-visible:text-text aria-pressed:border-accent aria-pressed:text-accent"
        >
          {t.key}
        </button>
      ))
    }
  </div>

  <ul data-part="grid" class="mt-6 grid max-w-3xl grid-cols-2 gap-4 md:grid-cols-3">
    {
      products.map((p) => (
        <li data-flip data-id={p.id} class="flex items-center gap-4 rounded-lg border border-line bg-ink-900 p-4">
          <svg viewBox="0 0 32 32" class="size-8 shrink-0 fill-line stroke-accent" stroke-width="1.25" aria-hidden="true" set:html={shapes[p.shape]} />
          <div class="min-w-0">
            <p class="text-sm text-text">{p.name}</p>
            <p class="font-mono text-xs tabular-nums text-muted">
              score <span data-part="score">{scoreOf(p, SIGNALS, false)}</span>
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <p data-part="status" aria-live="polite" class="sr-only"></p>
  <figcaption class="mt-3 max-w-3xl text-sm text-muted">
    Placeholder products with illustrative scores. Recent searches, product views, cart, orders and category affinity
    add to one score, an admin boost lifts promoted products, and the feed sorts by the result.
  </figcaption>
</figure>

<script>
  import { Flip, gsap, MQ } from "../../lib/gsap";
  import { onScene } from "../../lib/scene";
  import { SIGNALS, PRODUCTS, rank, scoreOf, type Signal } from "./for-you-model";

  onScene("for-you", (root) => {
    const q = gsap.utils.selector(root);
    const panel = q("[data-part=toggles]")[0];
    const grid = q("[data-part=grid]")[0];
    const status = q("[data-part=status]")[0];
    const buttons = q("[data-signal]");
    const cards = Object.fromEntries(q("[data-flip]").map((card) => [card.dataset.id!, card]));
    const initial = q("[data-flip]");
    panel.hidden = false;

    const mm = gsap.matchMedia();

    mm.add({ motion: MQ.motion, reduce: MQ.reduce }, (ctx) => {
      const { motion } = ctx.conditions as Record<string, boolean>;
      let flip: gsap.core.Timeline | undefined;

      const onClick = (event: Event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>("[data-signal]");
        if (!button) return;
        button.setAttribute("aria-pressed", String(button.getAttribute("aria-pressed") !== "true"));

        const on = buttons.filter((b) => b.getAttribute("aria-pressed") === "true").map((b) => b.dataset.signal!);
        const signals = SIGNALS.filter((s: Signal) => on.includes(s));
        const boost = on.includes("Admin boost");
        const order = rank(signals, boost);

        const state = motion ? Flip.getState(initial) : null;
        order.forEach((p) => {
          const card = cards[p.id];
          card.querySelector("[data-part=score]")!.textContent = String(scoreOf(p, signals, boost));
          grid.append(card);
        });
        if (state) {
          flip?.kill();
          // Transforms only: the grid keeps its slots, so nothing below it moves.
          flip = Flip.from(state, { duration: 0.5, ease: "power2.inOut" });
        }
        status.textContent = `Top of the feed: ${order[0].name}`;
      };
      panel.addEventListener("click", onClick);

      return () => {
        panel.removeEventListener("click", onClick);
        flip?.kill();
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.signal !== "Admin boost")));
        PRODUCTS.forEach((p) => {
          cards[p.id].querySelector("[data-part=score]")!.textContent = String(scoreOf(p, SIGNALS, false));
        });
        initial.forEach((card) => grid.append(card));
        status.textContent = "";
      };
    });

    return () => {
      mm.revert();
      panel.hidden = true;
    };
  });
</script>
