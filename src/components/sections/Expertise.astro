---
// TODO(sakib): sample content, drawn from the content brief. Replace with your own wording.
const expertise = [
  {
    title: "Backend Systems",
    stack: "FastAPI, Celery, PostgreSQL",
    body: "Queues, retries, idempotency and audit trails. Systems that stay correct when traffic spikes, devices go offline or data arrives twice.",
    icon: "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6",
  },
  {
    title: "Frontend & Mobile",
    stack: "Next.js, React, React Native",
    body: "Main lead for the Govaly mobile app and customer website: homepage, search, category and profile pages.",
    icon: "M3 5h18v11H3zM8 21h8M12 16v5",
  },
  {
    title: "AI-assisted Engineering",
    stack: "Claude Code, Codex",
    body: "Generated code that fits the existing system, and nothing merges unverified. Context docs, review skills, diff-first verification.",
    icon: "M12 3l2 7 7 2-7 2-2 7-2-7-7-2 7-2z",
  },
];
---

<section data-scene="expertise" class="mx-auto w-full max-w-6xl px-6 py-24 md:px-10 md:py-32">
  <h2
    data-part="title"
    class="text-center text-[clamp(2rem,4vw,2.5rem)] font-semibold leading-tight tracking-[-0.02em]"
  >
    My Expertise
  </h2>
  <div data-part="panel" class="relative isolate mt-10 overflow-hidden rounded-lg border border-line bg-ink-900">
    <svg data-part="trace" aria-hidden="true" class="pointer-events-none absolute inset-0 size-full opacity-0">
      <rect width="100%" height="100%" rx="8" fill="none" stroke-width="2" class="stroke-accent"></rect>
    </svg>
    <ul class="grid divide-y divide-line lg:grid-cols-3 lg:grid-rows-[auto_auto] lg:divide-x lg:divide-y-0">
      {
        expertise.map((item) => (
          <li data-part="card" class="p-6 lg:row-span-2 lg:grid lg:grid-rows-subgrid lg:gap-y-5 lg:p-8">
            <div class="flex items-start gap-4">
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke-width="1.25"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-10 shrink-0 stroke-accent"
              >
                <path data-part="icon" d={item.icon} />
              </svg>
              <h3 class="text-xl font-semibold leading-snug tracking-[-0.02em]">
                <span class="relative isolate inline-block">
                  <span
                    data-part="bar"
                    aria-hidden="true"
                    class="absolute inset-x-0 bottom-[0.1em] -z-10 h-[0.3em] origin-left bg-accent/45"
                  />
                  {item.title}
                </span>
                <span data-part="stack" class="block font-mono text-sm font-normal tracking-normal text-muted">
                  {item.stack}
                </span>
              </h3>
            </div>
            <div class="mt-5 lg:mt-0">
              <p data-part="tag" aria-hidden="true" class="font-mono text-xs text-muted">&lt;p&gt;</p>
              <div class="relative my-2 ml-1 pl-5">
                <span data-part="rail" aria-hidden="true" class="absolute inset-y-0 left-0 w-px origin-top bg-line" />
                <p data-part="body" class="font-mono text-sm leading-relaxed text-text">{item.body}</p>
              </div>
              <p data-part="tag" aria-hidden="true" class="font-mono text-xs text-muted">&lt;/p&gt;</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { gsap, MQ, SplitText } from "../../lib/gsap";
  import { onScene } from "../../lib/scene";
  import { blueprintCursor } from "../../lib/cursor";
  import { decode } from "../../lib/decode";

  onScene("expertise", (root) => {
    const q = gsap.utils.selector(root);
    const panel = q("[data-part=panel]")[0] as HTMLElement;
    // Inside the solid panel the grid only exists around the pointer, like an x-ray of the blueprint.
    const stopCursor = blueprintCursor(panel);
    const mm = gsap.matchMedia();

    mm.add({ motion: MQ.motion, desktop: MQ.desktop }, (ctx) => {
      const { motion, desktop } = ctx.conditions as Record<string, boolean>;
      if (!motion) return;

      const stacks = gsap.utils.toArray<HTMLElement>("[data-part=stack]", root);
      const finals = stacks.map((el) => el.textContent ?? "");

      // The title's letters arrive scattered and settle into order, the site's idea in small.
      const title = SplitText.create(q("[data-part=title]"), { type: "words,chars" });
      gsap.from(title.chars, {
        opacity: 0,
        x: () => gsap.utils.random(-48, 48),
        y: () => gsap.utils.random(-28, 28),
        rotation: () => gsap.utils.random(-18, 18),
        stagger: { each: 0.03, from: "random" },
        duration: 0.8,
        scrollTrigger: { trigger: q("[data-part=title]")[0], start: "top 85%", once: true },
        onComplete: () => title.revert(),
      });

      // Two strokes leave one corner and meet at the opposite one, tracing the panel, then fade to its border.
      const trace = q("[data-part=trace]")[0];
      gsap.set(trace, { opacity: 1 });
      const master = gsap.timeline({ scrollTrigger: { trigger: panel, start: "top 80%", once: true } });
      master.from(q("[data-part=trace] rect"), { drawSVG: "50% 50%", duration: 1, ease: "power2.inOut" }, 0);
      master.to(trace, { opacity: 0, duration: 0.5 }, 0.9);

      const undoHover = gsap.utils.toArray<HTMLElement>("[data-part=card]", root).map((card, i) => {
        const part = gsap.utils.selector(card);
        const stack = part("[data-part=stack]")[0] as HTMLElement;
        const body = SplitText.create(part("[data-part=body]"), { type: "words,chars" });
        const [open, close] = part("[data-part=tag]");

        const tl = gsap.timeline({
          scrollTrigger: desktop ? undefined : { trigger: card, start: "top 85%", once: true },
          onComplete: () => body.revert(),
        });
        tl.from(card, { opacity: 0, y: 16, duration: 0.5 }, 0);
        tl.from(part("[data-part=icon]"), { drawSVG: "0%", duration: 0.9, ease: "power2.inOut" }, 0.1);
        tl.from(part("[data-part=bar]"), { scaleX: 0, duration: 0.5 }, 0.4);
        tl.from(stack, { opacity: 0, duration: 0.15 }, 0.45);
        tl.add(decode(stack, 0.7), 0.45);
        tl.from(open, { opacity: 0, duration: 0.25 }, 0.7);
        tl.from(part("[data-part=rail]"), { scaleY: 0, duration: 0.6 }, 0.8);
        // Printed character by character, like the code the panel is styled after.
        tl.from(body.chars, { opacity: 0, duration: 0.01, stagger: 0.005, ease: "none" }, 0.85);
        tl.from(close, { opacity: 0, duration: 0.25 });

        if (desktop) master.add(tl, 0.35 + i * 0.2);

        // Hovering a card redraws its icon and underline. Nothing to focus here: the cards aren't controls.
        const onEnter = () => {
          if (master.isActive() || tl.isActive()) return;
          gsap.fromTo(
            part("[data-part=icon]"),
            { drawSVG: "0%" },
            { drawSVG: "100%", duration: 0.8, ease: "power2.inOut", overwrite: "auto" }
          );
          gsap.fromTo(part("[data-part=bar]"), { scaleX: 0 }, { scaleX: 1, duration: 0.5, overwrite: "auto" });
        };
        if (desktop) card.addEventListener("pointerenter", onEnter);
        return () => card.removeEventListener("pointerenter", onEnter);
      });

      return () => {
        undoHover.forEach((fn) => fn());
        stacks.forEach((el, i) => (el.textContent = finals[i]));
      };
    });

    return () => {
      mm.revert();
      stopCursor();
    };
  });
</script>
