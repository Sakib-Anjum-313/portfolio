---
import { Image } from "astro:assets";
import photo from "../../assets/sakib-avatar.png";
import { site, about, hero } from "../../data/site";

const corners = [
  { x: -1, y: -1, class: "left-0 top-0 border-l border-t" },
  { x: 1, y: -1, class: "right-0 top-0 border-r border-t" },
  { x: -1, y: 1, class: "bottom-0 left-0 border-b border-l" },
  { x: 1, y: 1, class: "bottom-0 right-0 border-b border-r" },
];
const dimensions = [site.city, hero.availability];
---

<section
  data-scene="intro"
  aria-label="Introduction"
  class="relative isolate flex min-h-[calc(100svh-var(--nav-h))] items-center overflow-clip"
>
  <span
    data-part="axis-x"
    aria-hidden="true"
    class="pointer-events-none absolute left-0 top-0 -z-10 h-px w-full bg-accent/30 opacity-0"
  ></span>
  <span
    data-part="axis-y"
    aria-hidden="true"
    class="pointer-events-none absolute left-0 top-0 -z-10 h-full w-px bg-accent/30 opacity-0"
  ></span>

  <div class="mx-auto w-full max-w-6xl px-6 py-16 md:px-10 md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div class="order-2 lg:order-1">
        <h1
          data-part="name"
          data-prehide
          class="text-[clamp(2.5rem,6vw,4.75rem)] font-semibold leading-[1.05] tracking-[-0.03em]"
        >
          {site.name}
        </h1>
        <p
          data-part="role"
          data-prehide
          class="mt-4 font-mono text-sm uppercase tracking-[0.12em] text-accent sm:tracking-[0.18em]"
        >
          {site.role}
        </p>
        <p data-part="about" data-prehide class="mt-8 max-w-[65ch] text-lg text-muted">{about}</p>
        <div data-part="links" data-prehide class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a href={site.github} class="text-muted transition-colors hover:text-text focus-visible:text-text">
            GitHub ↗
          </a>
          <a href={site.linkedin} class="text-muted transition-colors hover:text-text focus-visible:text-text">
            LinkedIn ↗
          </a>
        </div>
      </div>

      <div class="order-1 flex justify-center lg:order-2 lg:justify-end">
        <figure data-prehide class="m-0 flex w-56 max-w-full flex-col gap-4 sm:w-72 lg:w-96">
          <p class="flex items-center gap-3 font-mono text-xs text-muted">
            <span data-part="rule" class="h-px flex-1 origin-right bg-accent/40"></span>
            <span data-part="label">{dimensions[0]}</span>
            <span data-part="rule" class="h-px flex-1 origin-left bg-accent/40"></span>
          </p>

          <div data-part="portrait" class="relative aspect-square">
            <div data-part="marks" aria-hidden="true" class="pointer-events-none absolute -inset-2">
              {
                corners.map((corner) => (
                  <span
                    data-part="mark"
                    data-x={corner.x}
                    data-y={corner.y}
                    class:list={["absolute size-5 border-accent", corner.class]}
                  />
                ))
              }
            </div>
            <div data-part="window" class="size-full overflow-hidden">
              <Image
                data-part="photo"
                src={photo}
                alt="Portrait of Sakib Anjum, wearing glasses and a black shirt, inside a glowing ring with a code symbol beside him"
                width={480}
                height={480}
                loading="eager"
                class="block size-full"
              />
            </div>
            <span
              data-part="scan"
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-0 top-0 h-px bg-accent opacity-0 shadow-[0_0_12px_var(--color-accent)]"
            ></span>
          </div>

          <p class="flex items-center gap-3 font-mono text-xs text-muted">
            <span data-part="rule" class="h-px flex-1 origin-right bg-accent/40"></span>
            <span data-part="label">{dimensions[1]}</span>
            <span data-part="rule" class="h-px flex-1 origin-left bg-accent/40"></span>
          </p>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, MQ, SplitText } from "../../lib/gsap";
  import { onScene } from "../../lib/scene";
  import { blueprintCursor } from "../../lib/cursor";
  import { decode } from "../../lib/decode";

  const SCAN = { duration: 0.9, ease: "power2.inOut" };

  onScene("intro", (root) => {
    const q = gsap.utils.selector(root);
    const stopCursor = blueprintCursor(root);
    const mm = gsap.matchMedia();
    const portrait = q("[data-part=portrait]")[0] as HTMLElement;
    const scan = q("[data-part=scan]")[0];
    // If the CSS failsafe already showed the content, hiding it again would flash.
    const shown = getComputedStyle(q("[data-part=name]")[0]).visibility === "visible";
    let entrance: gsap.core.Timeline | undefined;

    // Separate from the pointer effects below, so resizing past a breakpoint never replays it.
    mm.add(MQ.motion, () => {
      if (shown) return;

      const role = q("[data-part=role]")[0] as HTMLElement;
      const labels = gsap.utils.toArray<HTMLElement>("[data-part=label]", root);
      const decoded = [role, ...labels];
      const finals = decoded.map((el) => el.textContent ?? "");

      const area = root.getBoundingClientRect();
      const box = portrait.getBoundingClientRect();
      const centerX = box.left + box.width / 2 - area.left;
      const centerY = box.top + box.height / 2 - area.top;
      // The marks sit 8px outside the portrait and are 20px square.
      const reach = box.width / 2 - 2;

      const name = SplitText.create(q("[data-part=name]"), { type: "chars" });
      const about = SplitText.create(q("[data-part=about]"), { type: "words" });

      gsap.set(q("[data-part=axis-x]"), { y: centerY, opacity: 1, transformOrigin: `${centerX}px 50%` });
      gsap.set(q("[data-part=axis-y]"), { x: centerX, opacity: 1, transformOrigin: `50% ${centerY}px` });

      const tl = gsap.timeline({
        onComplete: () => {
          name.revert();
          about.revert();
        },
      });
      entrance = tl;

      // Two drafting lines find the portrait's centre, the frame opens from there, then a scan reveals the photo.
      tl.from(q("[data-part=axis-x]"), { scaleX: 0, duration: 0.8, ease: "power2.inOut" }, 0);
      tl.from(q("[data-part=axis-y]"), { scaleY: 0, duration: 0.8, ease: "power2.inOut" }, 0);
      gsap.utils.toArray<HTMLElement>("[data-part=mark]", root).forEach((mark) => {
        tl.from(
          mark,
          {
            x: -Number(mark.dataset.x) * reach,
            y: -Number(mark.dataset.y) * reach,
            opacity: 0,
            duration: 0.6,
            ease: "back.out(1.6)",
          },
          0.45
        );
      });
      tl.from(q("[data-part=window]"), { yPercent: -100, ...SCAN }, 0.75);
      tl.from(q("[data-part=photo]"), { yPercent: 100, ...SCAN }, 0.75);
      tl.set(scan, { opacity: 1 }, 0.75);
      tl.fromTo(scan, { y: 0 }, { y: box.height, ...SCAN }, 0.75);
      tl.to(scan, { opacity: 0, duration: 0.25 }, 1.5);
      tl.to(q("[data-part=axis-x], [data-part=axis-y]"), { opacity: 0, duration: 0.5 }, 1.3);

      tl.from(
        name.chars,
        {
          opacity: 0,
          yPercent: 45,
          rotationX: -85,
          transformPerspective: 600,
          transformOrigin: "50% 100%",
          stagger: 0.035,
          duration: 0.8,
        },
        0.1
      );
      tl.from(role, { opacity: 0, duration: 0.15 }, 0.35);
      tl.add(decode(role, 0.9), 0.35);
      tl.from(about.words, { opacity: 0, y: 8, stagger: 0.012, duration: 0.5 }, 0.6);
      tl.from(q("[data-part=links] a"), { opacity: 0, y: 8, stagger: 0.08, duration: 0.4 }, 1.35);

      tl.from(q("[data-part=rule]"), { scaleX: 0, duration: 0.6 }, 1.2);
      labels.forEach((label) => {
        tl.from(label, { opacity: 0, duration: 0.15 }, 1.2);
        tl.add(decode(label, 0.7), 1.2);
      });

      return () => decoded.forEach((el, i) => (el.textContent = finals[i]));
    });

    // The portrait turns toward the pointer and its frame floats at a different depth. Sweeps on hover.
    mm.add(`${MQ.motion} and ${MQ.desktop} and (hover: hover)`, () => {
      const marks = q("[data-part=marks]")[0];
      const pose = { duration: 0.7, ease: "power3" };
      gsap.set(portrait, { transformPerspective: 900 });

      const turnX = gsap.quickTo(portrait, "rotationX", pose);
      const turnY = gsap.quickTo(portrait, "rotationY", pose);
      const floatX = gsap.quickTo(marks, "x", pose);
      const floatY = gsap.quickTo(marks, "y", pose);

      const aim = (x: number, y: number) => {
        turnX(-y * 12);
        turnY(x * 12);
        floatX(-x * 12);
        floatY(-y * 12);
      };
      const onMove = (event: PointerEvent) => {
        if (event.pointerType === "mouse") {
          aim(event.clientX / window.innerWidth - 0.5, event.clientY / window.innerHeight - 0.5);
        }
      };
      const onLeave = () => aim(0, 0);
      const onEnter = () => {
        if (entrance?.isActive()) return;
        gsap.set(scan, { opacity: 1 });
        gsap.fromTo(
          scan,
          { y: 0 },
          {
            y: portrait.offsetHeight,
            duration: 0.8,
            ease: "sine.inOut",
            overwrite: "auto",
            onComplete: () => gsap.set(scan, { opacity: 0 }),
          }
        );
      };

      root.addEventListener("pointermove", onMove);
      root.addEventListener("pointerleave", onLeave);
      portrait.addEventListener("pointerenter", onEnter);

      return () => {
        root.removeEventListener("pointermove", onMove);
        root.removeEventListener("pointerleave", onLeave);
        portrait.removeEventListener("pointerenter", onEnter);
      };
    });

    q("[data-prehide]").forEach((el) => el.setAttribute("data-ready", ""));

    return () => {
      mm.revert();
      stopCursor();
    };
  });
</script>
