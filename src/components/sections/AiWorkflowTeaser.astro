---
import { aiWorkflow, principles } from "../../data/ai-workflow";
import SectionLabel from "../ui/SectionLabel.astro";
import ArrowLink from "../ui/ArrowLink.astro";
import FlowDiagram from "../diagrams/FlowDiagram.astro";
import { agentLoop } from "../diagrams/specs";
---

<section class="mx-auto w-full max-w-6xl px-6 py-24 md:px-10 md:py-32">
  <SectionLabel as="p" index="04" name="AI WORKFLOW" />
  <div class="mt-10 grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div>
      <h2 data-reveal class="text-3xl font-semibold tracking-[-0.02em] md:text-[2.5rem] md:leading-tight">
        {aiWorkflow.headline}
      </h2>
      <p class="mt-6 max-w-[65ch] text-muted">{aiWorkflow.subline}</p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {
          principles.slice(0, 3).map((p) => (
            <li class="rounded-full border border-line px-3 py-1 text-sm text-text">{p.title}</li>
          ))
        }
      </ul>
      <p
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 font-mono text-xs text-text"
      >
        <span class="size-1.5 rounded-full bg-wait" aria-hidden="true"></span>
        {aiWorkflow.certification}
      </p>
      <p class="mt-8">
        <ArrowLink href="/ai-workflow">How I build with AI</ArrowLink>
      </p>
    </div>
    <FlowDiagram
      id="agent-loop"
      spec={agentLoop}
      scroll
      caption="Each change moves from context to plan, build and verify. A rejected assumption loops back to plan, and only a verified change reaches merge."
    />
  </div>
</section>
