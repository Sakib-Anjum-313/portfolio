---
import { site } from "../../data/site";
import SectionLabel from "../ui/SectionLabel.astro";
import CopyEmail from "../ui/CopyEmail.astro";
import ArrowLink from "../ui/ArrowLink.astro";
---

<section class="mx-auto w-full max-w-6xl px-6 py-24 md:px-10 md:py-32">
  <SectionLabel index="05" name="CONTACT" />
  <h2 data-reveal class="mt-10 max-w-[20ch] text-3xl font-semibold tracking-[-0.02em] md:text-[2.5rem] md:leading-tight">
    Building something with messy real-world data? Let's talk.
  </h2>
  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
    <a
      href={`mailto:${site.email}`}
      class="font-mono text-text transition-colors hover:text-accent focus-visible:text-accent"
    >
      {site.email}
    </a>
    <CopyEmail email={site.email} />
  </div>
  <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <ArrowLink href={site.linkedin} external>LinkedIn</ArrowLink>
    <ArrowLink href={site.github} external>GitHub</ArrowLink>
    <ArrowLink href={site.resume} external newTab>Resume</ArrowLink>
  </p>
</section>
