---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div>
  <p class="font-mono text-4xl font-semibold tabular-nums text-text">
    <span class="sr-only">{value}</span>
    <span data-count aria-hidden="true">{value}</span>
  </p>
  <p class="mt-2 text-sm text-muted">{label}</p>
  <slot />
</div>
