---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class="w-full" data-part="latency">
  {
    compact ? (
      <div aria-hidden="true" class="mt-3 space-y-1.5">
        <div class="h-1.5 w-full rounded-full bg-line" />
        <div class="h-1.5 w-1/3 rounded-full bg-accent" />
      </div>
    ) : (
      <div class="space-y-4 font-mono text-sm tabular-nums">
        <div>
          <div class="mb-1.5 flex justify-between text-muted">
            <span>Before</span>
            <span class="text-text">1.2s</span>
          </div>
          <div class="h-2 w-full rounded-full bg-line" aria-hidden="true" />
        </div>
        <div>
          <div class="mb-1.5 flex justify-between text-muted">
            <span>After</span>
            <span class="text-text">0.4s · −67%</span>
          </div>
          <div class="h-2 w-1/3 rounded-full bg-accent" aria-hidden="true" />
        </div>
      </div>
    )
  }
</div>
